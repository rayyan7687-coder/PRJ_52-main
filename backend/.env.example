# Local development settings. Copy this file to .env and change values as needed.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-local-secret-at-least-32-characters
DATABASE_URL=sqlite:///./buildloop.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production example (never commit the real values):
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/buildloop
# CORS_ORIGINS=https://your-frontend-domain.com
